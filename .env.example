# Copiar a .env y completar. .env esta en .gitignore y no se commitea.

# Google AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: cascada de modelos, en orden de preferencia.
# El free tier devuelve 503 intermitentes, por eso se prueba mas de uno.
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-flash-latest

# Credenciales de acceso (en produccion viven en las env vars de Netlify)
ADMIN_USER=
ADMIN_PASS=
CLIENT_USER=
CLIENT_PASS=
